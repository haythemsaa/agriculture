APP_NAME="AgriTech Tunisia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Tunis
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agritech
DB_USERNAME=postgres
DB_PASSWORD=

# MongoDB Database
MONGODB_CONNECTION=mongodb
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=agritech_logs
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Queue
QUEUE_CONNECTION=redis
HORIZON_PREFIX=agritech:

# Cache
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Broadcasting
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@agritech.tn"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 / MinIO
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Elasticsearch
ELASTICSEARCH_HOST=localhost:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASS=

# Payment Gateways
PAYMEE_API_KEY=
PAYMEE_SECRET=
FLOUCI_API_KEY=
FLOUCI_SECRET=
D17_API_KEY=
D17_SECRET=

# Commission Platform (%)
PLATFORM_COMMISSION_DEFAULT=10
PLATFORM_COMMISSION_SMALL=12
PLATFORM_COMMISSION_LARGE=8
PLATFORM_COMMISSION_PREMIUM=7

# Weather API
OPENWEATHER_API_KEY=

# ML/AI Service
ML_API_URL=http://localhost:8001
ML_API_KEY=

# SMS Gateway
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Application Settings
MAX_UPLOAD_SIZE=10240
ITEMS_PER_PAGE=20
MINIMUM_ORDER_AMOUNT=10
DELIVERY_FEE_BASE=5
DELIVERY_FEE_PER_KM=0.5
